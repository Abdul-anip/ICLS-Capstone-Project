# ─── Template Konfigurasi ICLS Backend ────────────────────────────────────────
# Salin berkas ini menjadi `.env` dan isi dengan nilai konfigurasi Anda.
# JANGAN pernah commit berkas `.env` yang asli ke Git!
#
# Cara menyalin:
#   cp .env.example .env

# ─── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=icls_db

# ─── JDoodle API ───────────────────────────────────────────────────────────────
# Dapatkan kredensial Anda di: https://www.jdoodle.com/compiler-api
JDOODLE_CLIENT_ID=your_jdoodle_client_id_here
JDOODLE_CLIENT_SECRET=your_jdoodle_client_secret_here

# ─── JWT Authentication ────────────────────────────────────────────────────────
# Gunakan string acak yang kuat, terutama di server production.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
ICLS_SECRET_KEY=your_random_secret_key_here
